{
  "name": "tether-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sw",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "e2e": "playwright test",
    "check": "npm run typecheck && eslint . && vitest run --configLoader runner && vite build --configLoader runner"
  },
  "dependencies": {
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "preact": "11.0.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.54.2",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "@xterm/headless": "6.0.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "playwright-core": "1.54.2"
  }
}
