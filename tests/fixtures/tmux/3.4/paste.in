load-buffer -b tether-2 '/tmp/tether-meridian-501/tether-fixture-42488/we ird'\''##{pane_id}$HOME;~.txt' ; paste-buffer -p -d -b tether-2 -t @0
load-buffer -b tether-3 '/tmp/tether-meridian-501/tether-fixture-42488/missing.txt' ; paste-buffer -p -d -b tether-3 -t @0
delete-buffer -b tether-3
load-buffer -b tether-4 '/tmp/tether-meridian-501/tether-fixture-42488/we ird'\''##{pane_id}$HOME;~.txt' ; paste-buffer -p -d -b tether-4 -t @99
delete-buffer -b tether-4
