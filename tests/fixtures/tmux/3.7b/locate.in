display-message -p '#{version}	#{pid}	#{start_time}	#{window_width}	#{window_height}'
refresh-client -C 80x24
refresh-client -A '%2:pause'
refresh-client -A '%3:pause'
display-message -p -t @0 '#{pid}	#{start_time}	#{session_id}	#{window_id}	#{pane_id}	#{pane_width}	#{pane_height}	#{session_name}'
display-message -p -t @1 '#{pid}	#{start_time}	#{session_id}	#{window_id}	#{pane_id}	#{pane_width}	#{pane_height}	#{session_name}'
display-message -p -t @2 '#{pid}	#{start_time}	#{session_id}	#{window_id}	#{pane_id}	#{pane_width}	#{pane_height}	#{session_name}'
display-message -p -t @3 '#{pid}	#{start_time}	#{session_id}	#{window_id}	#{pane_id}	#{pane_width}	#{pane_height}	#{session_name}'
display-message -p -t '$0' '#{pid}	#{start_time}	#{session_id}'
display-message -p -t '$1' '#{pid}	#{start_time}	#{session_id}'
