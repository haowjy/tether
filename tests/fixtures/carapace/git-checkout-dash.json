{"version":"v1.16.2","messages":[],"noprefix":"","nospace":".","usage":"","values":[{"value":"--auto-advance","display":"--auto-advance","description":"auto advance to the next file when selecting hunks interactively","tag":"longhand flags"},{"value":"--conflict","display":"--conflict","description":"conflict style (merge or diff3)","style":"blue","tag":"longhand flags"},{"value":"--detach","display":"--detach","description":"detach HEAD at named commit","tag":"longhand flags"},{"value":"--force","display":"--force","description":"force checkout (throw away local modifications)","tag":"longhand flags"},{"value":"--guess","display":"--guess","description":"second guess 'git checkout \u003cno-such-branch\u003e' (default)","tag":"longhand flags"},{"value":"--ignore-other-worktrees","display":"--ignore-other-worktrees","description":"do not check if another worktree is holding the given ref","tag":"longhand flags"},{"value":"--ignore-skip-worktree-bits","display":"--ignore-skip-worktree-bits","description":"do not limit pathspecs to sparse entries only","tag":"longhand flags"},{"value":"--inter-hunk-context","display":"--inter-hunk-context","description":"show context between diff hunks up to the specified number of lines","style":"blue","tag":"longhand flags"},{"value":"--merge","display":"--merge","description":"perform a 3-way merge with the new branch","tag":"longhand flags"},{"value":"--no-guess","display":"--no-guess","description":"do not second guess 'git checkout \u003cno-such-branch\u003e'","tag":"longhand flags"},{"value":"--no-overlay","display":"--no-overlay","description":"remove files not in \u003ctree-ish\u003e","tag":"longhand flags"},{"value":"--no-overwrite-ignore","display":"--no-overwrite-ignore","description":"do not overwrite ignored files when switching branches","tag":"longhand flags"},{"value":"--no-progress","display":"--no-progress","description":"do not show progress","tag":"longhand flags"},{"value":"--no-recurse-submodules","display":"--no